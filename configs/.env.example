# Inside Airbnb ETL — environment overrides
#
# configs/config.yaml is the primary declarative configuration file.
# Everything here is an OPTIONAL override of that file, useful for CI, Docker
# and one-off runs. Precedence (highest first):
#
#   CLI/init args > environment variables > this .env file > configs/config.yaml > code defaults
#
# Copy this file to .env only when you need to override something.

# PostgreSQL connection (overrides database.* in config.yaml)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=airbnb
# POSTGRES_USER=airbnb
# POSTGRES_PASSWORD=airbnb

# Data root directory (overrides data.data_path in config.yaml)
# DATA_PATH=./data

# Dashboard data source (overrides dashboard.* in config.yaml)
# DASHBOARD_SOURCE=auto
# DASHBOARD_DEMO_DIR=data/demo

# Pipeline tuning (overrides pipeline.* in config.yaml)
# BATCH_SIZE=100000
# CHUNK_SIZE=250000
# VALIDATE_DATA=true
# SKIP_INVALID_ROWS=false
# USE_COPY=true
# Replace the loaded snapshot on a full run (truncate raw/staging/marts first).
# REPLACE_ON_LOAD=true

# Logging (overrides logging.level in config.yaml)
# LOG_LEVEL=INFO
